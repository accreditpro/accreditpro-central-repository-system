# AccreditPro - Environment Configuration
# ---------------------------------------------------------------------------
# This file sets defaults for the deployed stage environment.
# To override locally (e.g. to run against local backend), create .env.local
# and set VITE_API_BASE_URL=http://localhost:8080/api
# ---------------------------------------------------------------------------

# Deployed Stage Backend
VITE_API_BASE_URL=https://api-stage.accreditpro.in/api

# Vite Dev Server Port
VITE_PORT=3000
